{
  "name": "@cartesia-cookbook/agents-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser client for the Cartesia Managed Agents WebSocket. Source-exported, no build step.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && node --check scripts/live-handshake.mjs",
    "test": "vitest run",
    "live": "tsx scripts/live-handshake.mjs"
  },
  "peerDependencies": {
    "@cartesia/cartesia-js": "^4.2.0",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@cartesia/cartesia-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cartesia/cartesia-js": "^4.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/ws": "^8.18.0",
    "jsdom": "^30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
