# Server only. Records the audio with Sonic 3.6. Get a key at https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# The LLM that writes the script. Set one. If several are set, the gateway wins, then Anthropic, then OpenAI.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional. Replaces the default model id for the provider picked above (see lib/model.ts).
PODCAST_MODEL=
# Optional. Voice ids for the two hosts, from https://play.cartesia.ai/voices. Defaults are Skylar and Daniel.
CARTESIA_VOICE_HOST_A=
CARTESIA_VOICE_HOST_B=
