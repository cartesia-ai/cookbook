# Server only. Get a key at https://play.cartesia.ai/keys. Used for ink-whisper transcription.
CARTESIA_API_KEY=
# The LLM that writes the notes, as provider/model, for example openai/gpt-5.4-mini or anthropic/claude-haiku-4-5.
LLM_MODEL=
# Set the key that matches the LLM_MODEL prefix.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Any other provider/model goes through the Vercel AI Gateway with this key. Not needed on a Vercel deployment.
AI_GATEWAY_API_KEY=
