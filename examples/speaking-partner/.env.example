# Server only. The browser never sees these. Get a key at https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Corrections panel. Set one of these. Without a key the app still runs and the panel says so.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. "anthropic:<model-id>" or "openai:<model-id>". Defaults to a small model for the key you set.
CORRECTIONS_MODEL=

# Optional. Model for the speaking partner itself, from GET /v1/agents/models.
AGENT_MODEL_ID=

# Optional. Pin a voice per language instead of the automatic pick.
VOICE_ID_EN=
VOICE_ID_ES=
VOICE_ID_FR=
VOICE_ID_HI=
VOICE_ID_JA=
