# Server only. The browser never sees this key. Get one at https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Written to .env.local by `pnpm setup:agent`. You can also paste an existing agent id.
CARTESIA_AGENT_ID=

# Optional. Read by `pnpm setup:agent`; run it with --force after changing them.
# LLM for the agent (default claude-haiku-4.5; GET /v1/agents/models lists the others).
AGENT_MODEL_ID=
# Agent voice id from https://play.cartesia.ai/voices.
CARTESIA_VOICE_ID=
