# Cartesia key for Sonic 3.6 (narration) and Ink 2 (spoken choices). Server only: the browser gets 60 second tokens.
CARTESIA_API_KEY=
# Model that writes the story, as provider/model, for example openai/gpt-5.4-mini or anthropic/claude-haiku-4-5. See README.
LLM_MODEL=
# Direct provider keys. Set the one that matches the LLM_MODEL prefix.
# OPENAI_API_KEY also turns on OpenAI moderation of names and scenes, whatever LLM_MODEL is.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Any other provider/model routes through the Vercel AI Gateway.
AI_GATEWAY_API_KEY=
