# Cartesia key. Server only: the browser gets 60 second access tokens from /api/token.
CARTESIA_API_KEY=
# Model for the translations, as provider/model, for example openai/gpt-5.4-mini or anthropic/claude-haiku-4-5. See README.
LLM_MODEL=
# Direct provider keys. Set the one that matches the LLM_MODEL prefix.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Any other provider/model routes through the Vercel AI Gateway.
AI_GATEWAY_API_KEY=
