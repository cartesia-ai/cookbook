# Cartesia API key, server only. https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Written by scripts/setup_agent.py. Leave empty on first run.
CARTESIA_AGENT_ID=

# Your business. The setup script bakes these into the agent's instructions, so run it again after changes.
BUSINESS_NAME=
# Comma list of what you offer, read to callers as is.
BUSINESS_SERVICES=
# IANA time zone, for example America/New_York.
BUSINESS_TIMEZONE=
# Opening hours, for example: mon-fri 09:00-17:00; sat 10:00-14:00
BUSINESS_HOURS=
# Minutes per appointment. Default 30.
APPOINTMENT_MINUTES=
# Optional. E.164 number (+14155550100) to hand callers to a person. Works on phone calls only.
TRANSFER_NUMBER=

# Optional. Public HTTPS address of this server (a tunnel or your deploy). Turns on webhook tools and call webhooks.
PUBLIC_BASE_URL=
# Written by the setup script when PUBLIC_BASE_URL is set.
TOOL_SECRET=
CARTESIA_WEBHOOK_ID=
CARTESIA_WEBHOOK_SECRET=

# Optional. Book into Cal.com instead of the local calendar.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Optional overrides.
AGENT_MODEL_ID=
CARTESIA_VOICE_ID=
DATABASE_PATH=
