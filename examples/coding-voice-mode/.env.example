# Used by `cartesia-voice-mode doctor`, `say`, `hear` and `install --save-key`.
# The MCP server reads CARTESIA_API_KEY from its environment, then from
# ~/.config/cartesia-voice-mode/env (mode 0600). Never put the key in a client config.
# Get a key at https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Optional. A Sonic voice id; defaults to Daniel (en-US).
CARTESIA_VOICE_ID=
