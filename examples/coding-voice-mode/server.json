{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cartesia-ai/cartesia-voice-mode",
  "title": "Cartesia voice mode",
  "description": "Talk to your coding agent. Cartesia Sonic 3.6 speaks, Ink 2 turn detection hears your reply.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/cartesia-ai/cookbook",
    "source": "github",
    "subfolder": "examples/coding-voice-mode"
  },
  "websiteUrl": "https://github.com/cartesia-ai/cookbook/tree/main/examples/coding-voice-mode",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "cartesia-voice-mode",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CARTESIA_API_KEY",
          "description": "Cartesia API key from https://play.cartesia.ai/keys",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "CARTESIA_VOICE_ID",
          "description": "Sonic voice id. Defaults to a stock English voice",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
