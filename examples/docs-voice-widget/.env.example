# Server only. Mints 60 second agent tokens and creates the agent. https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Server only. Embeds your docs at ingest and each question at search time.
OPENAI_API_KEY=
# Written by `pnpm setup:agent`. Leave empty until then.
CARTESIA_AGENT_ID=
CARTESIA_TOOL_IDS=

# Sites allowed to start sessions, comma separated, for example https://docs.example.com
# The server's own origin is always allowed. Empty means only the demo page works.
ALLOWED_ORIGINS=
# Public URL of this server when it runs behind a proxy, for example https://docs-voice.example.com
PUBLIC_URL=
# Set to 1 behind a proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=
PORT=4512
# The widget ends a session after this many seconds.
MAX_SESSION_SECS=300
WIDGET_TITLE=Ask the docs
# Set to 0 to turn off the demo docs site at / when you only serve the widget.
DEMO_SITE=

# Optional, read by `pnpm setup:agent`.
AGENT_MODEL_ID=
CARTESIA_VOICE_ID=
AGENT_LANGUAGE=
