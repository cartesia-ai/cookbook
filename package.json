{
  "name": "cartesia-cookbook",
  "private": true,
  "description": "Templates and recipes for Cartesia speech and voice agents: Sonic text to speech, Ink speech to text and Managed Agents in Next.js, Python, Node and Expo.",
  "keywords": [
    "cartesia",
    "text-to-speech",
    "tts",
    "speech-to-text",
    "stt",
    "voice-agent",
    "voice-ai",
    "speech-synthesis",
    "speech-recognition",
    "realtime",
    "websocket",
    "sonic",
    "ink",
    "nextjs",
    "expo",
    "python",
    "templates",
    "examples",
    "cookbook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cartesia-ai/cookbook.git"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "check": "pnpm check:facts && pnpm check:content && pnpm check:catalog && pnpm check:copies && pnpm typecheck && pnpm test",
    "check:facts": "node tools/check-facts/index.mjs",
    "check:content": "node tools/check-content/index.mjs",
    "check:catalog": "node tools/check-catalog/index.mjs",
    "check:copies": "node tools/check-copies/index.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
